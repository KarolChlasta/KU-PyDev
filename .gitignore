# ============================================
# Podstawy programowania w Pythonie – .gitignore
# ============================================

# --- Foldery kursowe ---
00_Materiały/
00_Materiały/*

# --- Skrypty pomocnicze ---
setup.sh

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
*.pdb
*.pkl
*.pickle
*.db
*.sqlite3

# --- Virtual environments ---
venv/
env/
.venv/
.python-version

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- Logi i cache ---
*.log
*.tmp
*.cache
.cache/
*.swp

# --- Pokrycie testami (lab 14) ---
.coverage
htmlcov/

# --- Edytory ---
# VS Code (ustawienia projektu – motyw slajdów – są w repo)
.vscode/*
!.vscode/settings.json
# PyCharm / JetBrains
.idea/
*.iml

# --- Systemowe ---
.DS_Store
Thumbs.db

# --- Pliki użytkownika ---
*.bak
*.old

# --- Archiwa ---
*.zip
*.tar
*.gz
*.rar
